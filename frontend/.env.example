VITE_SUPABASE_URL= #URL del proyecto en Supabase (Settings > API > Project URL)
VITE_SUPABASE_ANON_KEY=#Clave pública anónima de Supabase (Settings > API > anon public)
 
VITE_AUTH_REDIRECT_URL=#URL de redirección después del login con OAuth (ej. Google)
# En local: http://localhost:5173/auth/callback
# En producción: https://tu-dominio.com/auth/callback

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=#Client Secret de Google OAuth para Supabase Auth (Google Cloud Console > APIs & Services > Credentials)

VITE_MAPBOX_TOKEN=#Token público de Mapbox para renderizar mapas (mapbox.com > Account > Tokens)
